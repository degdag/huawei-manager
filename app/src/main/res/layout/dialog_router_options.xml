<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#101721"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="— Router Options —"
        android:textAlignment="center"
        android:textColor="@color/text_red"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="— Power —"
        android:textAlignment="center"
        android:textColor="@color/text_yellow"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOptRestart"
            app:backgroundTint="@null"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/pill_green"
            android:text="Restart"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOptShutdown"
            app:backgroundTint="@null"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/pill_red"
            android:text="ShutDown"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOptDebug"
            app:backgroundTint="@null"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/pill_cyan"
            android:text="Debug Mode"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="— IP Address/Mobile data —"
        android:textAlignment="center"
        android:textColor="@color/text_yellow"
        android:textSize="12sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnOptRefreshIp"
        app:backgroundTint="@null"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/pill_blue"
        android:text="Refresh IP Address"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="— Statistic —"
        android:textAlignment="center"
        android:textColor="@color/text_yellow"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/box_section"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView android:id="@+id/tvStatUptime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total Router Uptime : 0 Day 0:00:00" android:textAlignment="center" android:textColor="@color/text_green" android:textSize="11sp" />
        <TextView android:id="@+id/tvStatTotalData" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total Size Of Data : 0GB" android:textAlignment="center" android:textColor="@color/text_green" android:textSize="11sp" />
        <TextView android:id="@+id/tvStatMonthlyUptime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Monthly Uptime : 0 Day 0:00:00" android:textAlignment="center" android:textColor="@color/text_green" android:textSize="11sp" />
        <TextView android:id="@+id/tvStatMonthlyData" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Monthly Total Data : 0GB" android:textAlignment="center" android:textColor="@color/text_green" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
