<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#101721"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvHeaderIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/btnMenu"
                android:text="http://192.168.8.1"
                android:textColor="#8899A6"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnNightMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text="💡"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnUsers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_dark"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Users 0"
                    android:textColor="#2ECC71"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/pill_dark"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="ℹ Info"
                    android:textColor="#3498DB"
                    android:textSize="10sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Signal & Logo Center Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvSig4G"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▂▄▆█\n2G/3G/4G"
                android:textAlignment="center"
                android:textColor="@color/text_red"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="16dp"
                android:src="@drawable/ic_huawei_flower" />

            <TextView
                android:id="@+id/tvSig5G"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▂▄▆█\n5G"
                android:textAlignment="center"
                android:textColor="@color/text_red"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Red Diagnostic Info -->
        <TextView
            android:id="@+id/tvDiagnostic1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BandWork :  Mode :  BandNRWork :  NetOption :"
            android:textAlignment="center"
            android:textColor="@color/text_red"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDiagnostic2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SetBand :    SetName :"
            android:textAlignment="center"
            android:textColor="@color/text_yellow"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDiagnostic3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="NetMode :  NetBand :  LTEBand :"
            android:textAlignment="center"
            android:textColor="@color/text_red"
            android:textSize="10sp" />

        <!-- 3 Header Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHomePage"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/pill_yellow"
                android:text="Home Page"
                android:textAllCaps="false"
                android:textColor="@color/text_yellow"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRouterOptions"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/pill_yellow"
                android:text="Router Options"
                android:textAllCaps="false"
                android:textColor="@color/text_yellow"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnLoginDialog"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/pill_yellow"
                android:text="Login Page"
                android:textAllCaps="false"
                android:textColor="@color/text_yellow"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- SECTION: Contact Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Contact Information —"
            android:textAlignment="center"
            android:textColor="@color/text_red"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/box_section"
            android:orientation="vertical"
            android:padding="2dp">

            <!-- Table Row 1 -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*">
                <TableRow android:background="@color/table_header_blue">
                    <TextView android:padding="4dp" android:text="Status" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="Device Model" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="Service" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <TableRow android:background="#131B28">
                    <TextView android:id="@+id/tvStatus" android:padding="4dp" android:text="No Connect" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvModel" android:padding="4dp" android:text="Unknown" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvService" android:padding="4dp" android:text="Unknown" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <TableRow android:background="@color/table_header_blue">
                    <TextView android:padding="4dp" android:text="PCI" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="Cell ID" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="TAC" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="eNBID" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <TableRow android:background="#131B28">
                    <TextView android:id="@+id/tvPci" android:padding="4dp" android:text="0" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvCellId" android:padding="4dp" android:text="0" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvTac" android:padding="4dp" android:text="0" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvEnbid" android:padding="4dp" android:text="0" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
            </TableLayout>

            <!-- Green Speed Row -->
            <TextView
                android:id="@+id/tvSpeedLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/speed_green"
                android:padding="3dp"
                android:text="D : 0K/s   U : 0K/s   T : 0K/s  (00:00:00)"
                android:textAlignment="center"
                android:textColor="@color/text_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Red Volume Row -->
            <TextView
                android:id="@+id/tvDataVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/speed_red"
                android:padding="3dp"
                android:text="D : 0K/s (0B/s)   U : 0K/s (0B/s)"
                android:textAlignment="center"
                android:textColor="@color/text_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Signal Strength Telemetry Table -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1">
                <TableRow android:background="@color/table_header_blue">
                    <TextView android:padding="4dp" android:text="Mode" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="Signal Strength" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="Evaluation" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <!-- RSSI -->
                <TableRow android:padding="2dp">
                    <TextView android:padding="4dp" android:text="RSSI" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvRssiVal" android:background="@drawable/pill_dark" android:padding="3dp" android:text="0" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvRssiEval" android:padding="4dp" android:text="Offline" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <!-- 3G RSCP -->
                <TableRow android:padding="2dp">
                    <TextView android:padding="4dp" android:text="3G-RSCP" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvRscpVal" android:background="@drawable/pill_dark" android:padding="3dp" android:text="0" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvRscpEval" android:padding="4dp" android:text="Offline" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <!-- 3G ECIO -->
                <TableRow android:padding="2dp">
                    <TextView android:padding="4dp" android:text="3G-ECIO" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvEcioVal" android:background="@drawable/pill_dark" android:padding="3dp" android:text="0" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvEcioEval" android:padding="4dp" android:text="Offline" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <!-- 4G RSRP -->
                <TableRow android:padding="2dp">
                    <TextView android:padding="4dp" android:text="4G-RSRP" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvRsrpVal" android:background="@drawable/pill_dark" android:padding="3dp" android:text="0" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvRsrpEval" android:padding="4dp" android:text="Offline" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <!-- 4G RSRQ -->
                <TableRow android:padding="2dp">
                    <TextView android:padding="4dp" android:text="4G-RSRQ" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvRsrqVal" android:background="@drawable/pill_dark" android:padding="3dp" android:text="0" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvRsrqEval" android:padding="4dp" android:text="Offline" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <!-- 4G SINR -->
                <TableRow android:padding="2dp">
                    <TextView android:padding="4dp" android:text="4G-SINR" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvSinrVal" android:background="@drawable/pill_dark" android:padding="3dp" android:text="0" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvSinrEval" android:padding="4dp" android:text="Offline" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- SECTION: Connection Settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Connection Settings —"
            android:textAlignment="center"
            android:textColor="@color/text_red"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/box_section"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnSpeedTest"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_dark"
                android:text="Speed Test"
                android:textAllCaps="false"
                android:textColor="@color/text_green"
                android:textSize="10sp" />

            <RadioGroup
                android:id="@+id/rgNetMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbAuto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:textColor="#FFF" android:textSize="10sp" android:checked="true" />
                <RadioButton android:id="@+id/rb5G" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5G" android:textColor="#FFF" android:textSize="10sp" />
                <RadioButton android:id="@+id/rb4G" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4G" android:textColor="#FFF" android:textSize="10sp" />
                <RadioButton android:id="@+id/rb3G" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3G" android:textColor="#FFF" android:textSize="10sp" />
                <RadioButton android:id="@+id/rb2G" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2G" android:textColor="#FFF" android:textSize="10sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btnApplyMode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_dark"
                android:text="Apply"
                android:textAllCaps="false"
                android:textColor="@color/text_green"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnSettingsGear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="⚙"
                android:textColor="@color/text_red"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- SECTION: Band Lock -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Band Lock —"
            android:textAlignment="center"
            android:textColor="@color/text_red"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box_section"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- 3G Band Row -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="— 3G Band —"
                android:textAlignment="center"
                android:textColor="@color/text_yellow"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <CheckBox android:id="@+id/cb3G_B8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="900-B8" android:textColor="@color/text_yellow" android:textSize="11sp" />
                <CheckBox android:id="@+id/cb3G_B1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="2100-B1" android:textColor="@color/text_yellow" android:textSize="11sp" />
            </LinearLayout>

            <!-- 4G FDD & TDD Columns -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <!-- FDD Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="— 4G Band FDD —" android:textAlignment="center" android:textColor="@color/text_green" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbFdd28" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="700-B28" android:textColor="@color/text_green" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbFdd3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1800-B3" android:textColor="@color/text_green" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbFdd1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2100-B1" android:textColor="@color/text_green" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbFdd7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2600-B7" android:textColor="@color/text_green" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbFdd20" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="800-B20" android:textColor="@color/text_green" android:textSize="11sp" />
                </LinearLayout>

                <!-- TDD Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="— 4G Band TDD —" android:textAlignment="center" android:textColor="@color/text_red" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbTdd40" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2300-B40" android:textColor="@color/text_red" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbTdd41" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2500-B41" android:textColor="@color/text_red" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbTdd38" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2600-B38" android:textColor="@color/text_red" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbTdd42" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3500-B42" android:textColor="@color/text_red" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnApplyBands"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/pill_yellow"
                android:text="Apply Band Lock"
                android:textAllCaps="false"
                android:textColor="@color/text_yellow"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
