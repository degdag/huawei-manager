<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#101721"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvHeaderIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/btnMenu"
                android:text="http://192.168.8.1/"
                android:textColor="#8899A6"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCountryFlag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="6dp"
                    android:text="🇲🇦"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnNightMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:text="💡"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnUsers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_green"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="1/32"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/pill_green"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Info"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAntenna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/pill_blue"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Internal"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Signal & Carrier Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvSig4G"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▂▄▆█\nLTE (4G)"
                android:textAlignment="center"
                android:textColor="@color/text_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:src="@drawable/ic_huawei_flower" />

            <TextView
                android:id="@+id/tvSig5G"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▂▄▆█\n5G"
                android:textAlignment="center"
                android:textColor="@color/text_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Diagnostics Text -->
        <TextView
            android:id="@+id/tvDiagOperator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Morocco 60400"
            android:textAlignment="center"
            android:textColor="@color/text_yellow"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiagnostic1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BandLTEWork : B7  Mode : 7"
            android:textAlignment="center"
            android:textColor="@color/text_red"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiagnostic2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SetBand : B7\nSetName : 2600"
            android:textAlignment="center"
            android:textColor="@color/text_green"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDiagnostic3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="NetMode : 03  NetBand : 3FFFFFFF  LTEBand : 40"
            android:textAlignment="center"
            android:textColor="@color/text_red"
            android:textSize="10sp" />

        <!-- 3 Header Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHomePage"
                app:backgroundTint="@null"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/pill_yellow"
                android:text="Home Page"
                android:textAllCaps="false"
                android:textColor="#F4D03F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRouterOptions"
                app:backgroundTint="@null"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/pill_yellow"
                android:text="Router Options"
                android:textAllCaps="false"
                android:textColor="#F4D03F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLoginDialog"
                app:backgroundTint="@null"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/pill_yellow"
                android:text="Login Page"
                android:textAllCaps="false"
                android:textColor="#F4D03F"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SECTION: Contact Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Contact Information —"
            android:textAlignment="center"
            android:textColor="@color/text_red"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/box_section"
            android:orientation="vertical"
            android:padding="2dp">

            <!-- Device Summary Table -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*">
                <TableRow android:background="@color/table_header_blue">
                    <TextView android:padding="4dp" android:text="Status" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="Device Model" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="Service" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <TableRow android:background="#131B28">
                    <TextView android:id="@+id/tvStatus" android:background="#27AE60" android:padding="4dp" android:text="Connected" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvModel" android:padding="4dp" android:text="B612s-25d" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvService" android:background="#27AE60" android:padding="4dp" android:text="Orange" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" />
                </TableRow>
                <TableRow android:background="@color/table_header_blue">
                    <TextView android:padding="4dp" android:text="PCI" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="Cell ID" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="TAC" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="eNBID/Cell" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
                <TableRow android:background="#131B28">
                    <TextView android:id="@+id/tvPci" android:padding="4dp" android:text="66" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvCellId" android:padding="4dp" android:text="4" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvTac" android:padding="4dp" android:text="50300" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvEnbid" android:padding="4dp" android:text="NaN/4" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>
            </TableLayout>

            <!-- Row 1: Session Traffic (Green) -->
            <TextView
                android:id="@+id/tvTrafficSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/speed_green"
                android:padding="3dp"
                android:text="D : 0.00GB   U : 0.00MB   T : 0.00GB  (00:00:00)"
                android:textAlignment="center"
                android:textColor="@color/text_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Row 2: Lifetime Traffic (Gold) -->
            <TextView
                android:id="@+id/tvTrafficTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/speed_gold"
                android:padding="3dp"
                android:text="D : 0.00TB   U : 0.00GB   T : 0.00TB  (0 Days 0:0:0)"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Row 3: Live Speed (Dark Red with highlighted rate) -->
            <TextView
                android:id="@+id/tvSpeedLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/speed_red"
                android:padding="3dp"
                android:text="D : 0.00Mbps (0B/s)    U : 0.00Kbps (0B/s)"
                android:textAlignment="center"
                android:textColor="@color/text_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Detailed Telemetry Table -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1">
                <TableRow android:background="@color/table_header_blue">
                    <TextView android:padding="4dp" android:text="4G" android:textColor="#00BCD4" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:padding="4dp" android:text="Signal Strength" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:padding="4dp" android:text="Evaluation" android:textAlignment="center" android:textColor="#FFF" android:textSize="11sp" />
                </TableRow>

                <!-- RSSI -->
                <TableRow android:padding="2dp">
                    <TextView android:padding="4dp" android:text="RSSI" android:textColor="#FFF" android:textSize="11sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="#1B2230">
                        <View android:id="@+id/barRssi" android:layout_width="0dp" android:layout_height="match_parent" android:background="#2ECC71" />
                        <TextView android:id="@+id/tvRssiVal" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="-67 dBm" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" />
                    </FrameLayout>
                    <TextView android:id="@+id/tvRssiEval" android:layout_marginStart="4dp" android:background="@drawable/pill_green" android:paddingHorizontal="4dp" android:paddingVertical="2dp" android:text="79% V.Good" android:textAlignment="center" android:textColor="#FFF" android:textSize="10sp" android:textStyle="bold" />
                </TableRow>

                <!-- 4G-RSRP -->
                <TableRow android:padding="2dp">
                    <TextView android:padding="4dp" android:text="4G-RSRP" android:textColor="#FFF" android:textSize="11sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="#1B2230">
                        <View android:id="@+id/barRsrp" android:layout_width="0dp" android:layout_height="match_parent" android:background="#E67E22" />
                        <TextView android:id="@+id/tvRsrpVal" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="-96 dBm" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" />
                    </FrameLayout>
                    <TextView android:id="@+id/tvRsrpEval" android:layout_marginStart="4dp" android:background="@drawable/pill_red" android:paddingHorizontal="4dp" android:paddingVertical="2dp" android:text="39% Weak" android:textAlignment="center" android:textColor="#FFF" android:textSize="10sp" android:textStyle="bold" />
                </TableRow>

                <!-- 4G-RSRQ -->
                <TableRow android:padding="2dp">
                    <TextView android:padding="4dp" android:text="4G-RSRQ" android:textColor="#FFF" android:textSize="11sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="#1B2230">
                        <View android:id="@+id/barRsrq" android:layout_width="0dp" android:layout_height="match_parent" android:background="#F39C12" />
                        <TextView android:id="@+id/tvRsrqVal" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="-9 dB" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" />
                    </FrameLayout>
                    <TextView android:id="@+id/tvRsrqEval" android:layout_marginStart="4dp" android:background="@drawable/pill_yellow" android:paddingHorizontal="4dp" android:paddingVertical="2dp" android:text="71% Good" android:textAlignment="center" android:textColor="#F4D03F" android:textSize="10sp" android:textStyle="bold" />
                </TableRow>

                <!-- 4G-SINR -->
                <TableRow android:padding="2dp">
                    <TextView android:padding="4dp" android:text="4G-SINR" android:textColor="#FFF" android:textSize="11sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="#1B2230">
                        <View android:id="@+id/barSinr" android:layout_width="0dp" android:layout_height="match_parent" android:background="#E67E22" />
                        <TextView android:id="@+id/tvSinrVal" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="4 dB" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" />
                    </FrameLayout>
                    <TextView android:id="@+id/tvSinrEval" android:layout_marginStart="4dp" android:background="@drawable/pill_red" android:paddingHorizontal="4dp" android:paddingVertical="2dp" android:text="43% Weak" android:textAlignment="center" android:textColor="#FFF" android:textSize="10sp" android:textStyle="bold" />
                </TableRow>
            </TableLayout>

            <!-- Advanced RF Metrics Rows -->
            <TextView android:id="@+id/tvTxPower" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="@color/speed_green" android:padding="3dp" android:text="4G-TxPower: PPusch: 7, PPucch: 3, PSrs: 0, PPrach: 12" android:textAlignment="center" android:textColor="#FFF" android:textSize="10sp" />
            <TextView android:id="@+id/tvEarfcn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:background="@color/speed_green" android:padding="3dp" android:text="4G-Earfcn: DL: 3250 UL: 21250" android:textAlignment="center" android:textColor="#FFF" android:textSize="10sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:orientation="horizontal">
                <TextView android:id="@+id/tvMcs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/pill_yellow" android:padding="3dp" android:text="4G-MCS: DL0:13  UL:16" android:textAlignment="center" android:textColor="@color/text_yellow" android:textSize="10sp" />
                <TextView android:id="@+id/tvTbs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_weight="1" android:background="@drawable/pill_yellow" android:padding="3dp" android:text="4G-TBS: DL0:18  UL:15" android:textAlignment="center" android:textColor="@color/text_green" android:textSize="10sp" />
            </LinearLayout>

            <TextView android:id="@+id/tvFreqBandwidth" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:background="@color/speed_green" android:padding="3dp" android:text="4G-Bandwidth: DL: 20MHz UL: 20MHz (100%)" android:textAlignment="center" android:textColor="#FFF" android:textSize="10sp" />
        </LinearLayout>

        <!-- SECTION: Connection Settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Connection Settings —"
            android:textAlignment="center"
            android:textColor="@color/text_red"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/box_section"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSpeedTest"
                app:backgroundTint="@null"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_green"
                android:paddingHorizontal="10dp"
                android:text="Speed Test"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <RadioGroup
                android:id="@+id/rgNetMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbAuto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:textColor="#FFF" android:textSize="10sp" android:checked="true" />
                <RadioButton android:id="@+id/rb4G" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4G" android:textColor="#FFF" android:textSize="10sp" />
                <RadioButton android:id="@+id/rb3G" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3G" android:textColor="#FFF" android:textSize="10sp" />
                <RadioButton android:id="@+id/rb2G" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2G" android:textColor="#FFF" android:textSize="10sp" />
            </RadioGroup>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApplyMode"
                app:backgroundTint="@null"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_green"
                android:paddingHorizontal="12dp"
                android:text="Done"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSettingsGear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="⚙"
                android:textColor="@color/text_red"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- SECTION: Frequency Stabilization -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Frequency Stabilization —"
            android:textAlignment="center"
            android:textColor="@color/text_red"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box_section"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="— Frequencies 3G —"
                android:textAlignment="center"
                android:textColor="@color/text_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <CheckBox android:id="@+id/cb3G_B8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="900 - B8" android:textColor="@color/text_yellow" android:textSize="11sp" />
                <CheckBox android:id="@+id/cb3G_B1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:text="2100 - B1" android:textColor="@color/text_yellow" android:textSize="11sp" />
            </LinearLayout>

            <!-- 4G FDD & TDD Columns -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <!-- FDD Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="— FDD —" android:textAlignment="center" android:textColor="@color/text_green" android:textSize="11sp" android:textStyle="bold" />
                    <CheckBox android:id="@+id/cbFdd20" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="800 - B20" android:textColor="@color/text_green" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbFdd8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="900 - B8" android:textColor="@color/text_green" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbFdd3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1800 - B3" android:textColor="@color/text_green" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbFdd1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2100 - B1" android:textColor="@color/text_green" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbFdd7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2600 - B7" android:textColor="@color/text_green" android:textSize="11sp" />
                </LinearLayout>

                <!-- TDD Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="— TDD —" android:textAlignment="center" android:textColor="@color/text_red" android:textSize="11sp" android:textStyle="bold" />
                    <CheckBox android:id="@+id/cbTdd40" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2300 - B40" android:textColor="@color/text_red" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbTdd41" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2500 - B41" android:textColor="@color/text_red" android:textSize="11sp" />
